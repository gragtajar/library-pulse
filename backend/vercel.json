{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/api/auth/slack", "dest": "/api/auth.js?fn=slack-start" },
    { "src": "/api/auth/slack-callback", "dest": "/api/auth.js?fn=slack-callback" },
    { "src": "/api/auth/figma", "dest": "/api/auth.js?fn=figma-start" },
    { "src": "/api/auth/figma-callback", "dest": "/api/auth.js?fn=figma-callback" },
    { "src": "/api/auth-status", "dest": "/api/auth.js?fn=status" },
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/api/slack/channels", "dest": "/api/slack.js?fn=channels" },
    { "src": "/api/slack/mentions", "dest": "/api/slack.js?fn=mentions" },
    { "src": "/api/figma/resolve-file", "dest": "/api/figma.js?fn=resolve-file" },
    { "src": "/api/email", "dest": "/api/email.js" },
    { "src": "/api/webhook", "dest": "/api/webhook.js" },
    { "src": "/api/health", "dest": "/api/health.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
